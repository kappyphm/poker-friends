# Copy to .env and fill in real values (NEVER commit .env)
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://poker:poker@localhost:5432/poker
SESSION_SECRET=replace-with-your-own-long-random-secret

# Log level for the pino logger: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Google OAuth — create credentials in Google Cloud Console
# Authorized redirect URI: http://localhost:4000/auth/google/callback
# Required unless DEV_AUTH=true.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev/test only — enables the name-only dev login. NEVER enable in production.
DEV_AUTH=true
